{
  "name": "pokeidle-hub",
  "productName": "PokeIdle Hub",
  "version": "3.1.0",
  "description": "Central de gestão, automação, telemetria de hunt e planejamento AFK para Pokeidle",
  "homepage": "https://github.com/Atauan/PokeIdle-Hub",
  "desktopName": "pokeidlehub.desktop",
  "main": "main.js",
  "author": {
    "name": "PokeIdle Hub",
    "email": "pokeidlehub@users.noreply.github.com"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "donation-qr": "node tools/make-donation-qr.js",
    "icon": "node tools/make-icon.js",
    "start": "node tools/make-icon.js && node tools/build-win-memory-trimmer.js && node tools/build-rotom.js && electron .",
    "dev": "node tools/make-icon.js && node tools/build-win-memory-trimmer.js && node tools/build-rotom.js && electron .",
    "dev:reset": "node tools/make-icon.js && node tools/build-win-memory-trimmer.js && node tools/build-rotom.js && electron . --dev-reset",
    "test": "node --test",
    "dist:mac": "node tools/make-icon.js && node tools/build-rotom.js && electron-builder --config electron-builder.config.cjs --mac",
    "dist:win": "node tools/make-icon.js && node tools/build-win-memory-trimmer.js && node tools/build-rotom.js && electron-builder --config electron-builder.config.cjs --win",
    "dist:win:qa": "node tools/make-icon.js && node tools/build-win-memory-trimmer.js && node tools/build-rotom.js && electron-builder --config electron-builder.qa.config.cjs --win",
    "dist:linux": "node tools/make-icon.js && node tools/build-rotom.js && electron-builder --config electron-builder.config.cjs --linux",
    "dist": "node tools/make-icon.js && node tools/build-win-memory-trimmer.js && node tools/build-rotom.js && electron-builder --config electron-builder.config.cjs --mac --win --linux"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "qrcode": "1.5.4"
  },
  "build": {
    "appId": "com.pokeidlehub.app",
    "productName": "PokeIdle Hub",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "about-window-service.js",
      "app-lifecycle.js",
      "main-window-service.js",
      "tray-service.js",
      "app-shell-ipc.js",
      "legacy-session-migration.js",
      "account-partition.js",
      "provider-connections.js",
      "live-account-preferences.js",
      "live-follow-service.js",
      "live-policy.js",
      "live-discovery.js",
      "live-runtime.js",
      "login-window-service.js",
      "notification-service.js",
      "update-notification-service.js",
      "update-download-service.js",
      "hub-working-set-cleanup-service.js",
      "windows-working-set-trimmer.js",
      "session-maintenance-service.js",
      "session-summary-service.js",
      "electron-session-service.js",
      "electron-webcontents-service.js",
      "live-content-purpose.js",
      "provider-connection-service.js",
      "provider-session-cleanup.js",
      "provider-connection-ipc.js",
      "rotom-cockpit-service.js",
      "rotom-cockpit-ipc.js",
      "browser-identity.js",
      "qa-profile.js",
      "dev-profile.js",
      "app-version.js",
      "live-status.js",
      "live-channel-url.js",
      "live-channel-policy.js",
      "live-status-ipc.js",
      "main-window-command-ipc.js",
      "market-sample-ipc.js",
      "release-updates.js",
      "game-channels.js",
      "game-session.js",
      "session-preload.js",
      "about-preload.js",
      "twitch-economy.js",
      "kick-economy.js",
      "preload.js",
      "webview-preload.js",
      "pokeidle-hunt.js",
      "rotom-addon.js",
      "renderer/**",
      "assets/**",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "pokeidle-hunt.js",
      "rotom-addon.js",
      "game-session.js",
      "game-channels.js",
      "twitch-economy.js",
      "kick-economy.js"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.entertainment",
      "icon": "build/icon.png",
      "identity": "-"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "build/win-memory-trimmer.exe",
          "to": "win-memory-trimmer.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "PokeIdle-Hub-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "PokeIdle-Hub-Portable-${version}.exe"
    },
    "dmg": {
      "artifactName": "PokeIdle-Hub-${version}-${arch}.dmg"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game",
      "icon": "build/icon.png",
      "maintainer": "PokeIdle Hub <pokeidlehub@users.noreply.github.com>",
      "syncDesktopName": true
    },
    "appImage": {
      "artifactName": "PokeIdle-Hub-${version}-x64.AppImage"
    },
    "deb": {
      "artifactName": "PokeIdle-Hub-${version}-amd64.deb"
    }
  }
}
